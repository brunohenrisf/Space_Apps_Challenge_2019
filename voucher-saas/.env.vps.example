# ConectaVoucher — deploy na VPS (Docker + Postgres + Caddy + Cloudflare).
# Copie para ".env" ao lado do docker-compose.yml e preencha,
# ou rode `bash scripts/setup-env.sh` para gerar os segredos.

# Domínio público (vira o registro DNS no Cloudflare e o host do Caddy).
CV_HOST=conectavoucher.seudominio.com

# Janela de cortesia (segundos) liberada só para pagamento.
COURTESY_WINDOW_SECONDS=180

# Senha do Postgres (rede interna, isolada). Gere forte.
CV_DB_PASSWORD=troque-por-uma-senha-forte

# ===== Painel do organizador =====
# Assina o token de sessão. Gere com: openssl rand -hex 32
AUTH_SECRET=troque-por-um-segredo-forte
# Admin inicial (criado no primeiro boot)
ADMIN_EMAIL=organizador@seudominio.com
ADMIN_PASSWORD=troque-por-uma-senha-forte
# Cadastro self-serve de novas contas: true (aberto) ou false (fechado)
ALLOW_SIGNUP=true

# ===== Efí (Pix) — coloque o certificado em ./certs/efi.p12 =====
EFI_ENV=producao
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
EFI_PIX_KEY=
# Segredo do webhook (HMAC na query ?hmac=). Gere forte.
EFI_WEBHOOK_TOKEN=troque-por-um-segredo-forte

# ===== MikroTik (via WireGuard) =====
# Use o IP do peer da MikroTik dentro do túnel (ver docs/DEPLOY.md § WireGuard).
MIKROTIK_HOST=10.20.0.2
MIKROTIK_PORT=8728
MIKROTIK_USER=api
MIKROTIK_PASSWORD=
MIKROTIK_TLS=false
MIKROTIK_HOTSPOT_PROFILE=default
