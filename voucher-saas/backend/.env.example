# ===== Servidor =====
PORT=3000
PUBLIC_URL=http://localhost:3000

# Janela de cortesia (segundos) liberada só para pagamento
COURTESY_WINDOW_SECONDS=180

# ===== Efí (Pix) — https://dev.efipay.com.br =====
EFI_ENV=sandbox
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
EFI_CERT_PATH=./certs/efi-homolog.p12
EFI_PIX_KEY=
EFI_WEBHOOK_TOKEN=

# ===== MikroTik (RouterOS API) =====
# Deixe host/senha em branco para rodar em modo MOCK (não conecta, só loga).
MIKROTIK_HOST=10.10.0.1
MIKROTIK_PORT=8728
MIKROTIK_USER=api
MIKROTIK_PASSWORD=
MIKROTIK_TLS=false
# Perfil/servidor Hotspot
MIKROTIK_HOTSPOT_PROFILE=default
MIKROTIK_HOTSPOT_SERVER=all
