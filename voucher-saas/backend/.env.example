# ===== Servidor =====
PORT=3000
PUBLIC_URL=http://localhost:3000

# ===== Efí (Pix) — https://dev.efipay.com.br =====
# Sandbox ou Produção
EFI_ENV=sandbox
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
# Caminho do certificado .p12 emitido no painel da Efí
EFI_CERT_PATH=./certs/efi-homolog.p12
# Chave Pix cadastrada na conta Efí que vai receber os pagamentos
EFI_PIX_KEY=
# Segredo usado para validar a autenticidade do webhook
EFI_WEBHOOK_TOKEN=

# ===== MikroTik (RouterOS API) =====
MIKROTIK_HOST=192.168.88.1
MIKROTIK_PORT=8728
MIKROTIK_USER=api
MIKROTIK_PASSWORD=
# Perfil PPPoE base usado ao criar o cliente do voucher
MIKROTIK_PPPOE_PROFILE=voucher-default

# ===== Regras de negócio =====
# Janela de cortesia (segundos) liberada só para pagamento
COURTESY_WINDOW_SECONDS=180
