# ===== Servidor =====
PORT=3000
PUBLIC_URL=http://localhost:3000

# Modo de acesso:
#  pppoe   -> cria /ppp/secret por voucher (topologia com servidor PPPoE)
#  hotspot -> cria /ip/hotspot/user com limit-uptime (captive portal p/ celular)
ACCESS_MODE=pppoe

# Janela de cortesia (segundos) liberada só para pagamento (usada no modo hotspot)
COURTESY_WINDOW_SECONDS=180

# ===== Efí (Pix) — https://dev.efipay.com.br =====
EFI_ENV=sandbox
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
EFI_CERT_PATH=./certs/efi-homolog.p12
EFI_PIX_KEY=
EFI_WEBHOOK_TOKEN=

# ===== MikroTik (RouterOS API) =====
# Deixe host/senha em branco para rodar em modo MOCK (não conecta, só loga).
MIKROTIK_HOST=10.10.0.1
MIKROTIK_PORT=8728
MIKROTIK_USER=api
MIKROTIK_PASSWORD=
MIKROTIK_TLS=false
# Perfil PPPoE base (modo pppoe)
MIKROTIK_PPPOE_PROFILE=voucher-default
# Perfil/servidor Hotspot (modo hotspot)
MIKROTIK_HOTSPOT_PROFILE=default
MIKROTIK_HOTSPOT_SERVER=all
