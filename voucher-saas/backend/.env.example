# ===== Servidor =====
PORT=3000
PUBLIC_URL=http://localhost:3000

# ===== Banco de dados (Prisma) =====
# Dev local (SQLite, sem serviço externo):
DATABASE_URL="file:./dev.db"
# Produção (Postgres): o docker-compose já injeta um postgresql://...

# Janela de cortesia (segundos) liberada só para pagamento
COURTESY_WINDOW_SECONDS=180

# ===== Painel do organizador (autenticação) =====
# Segredo que assina o token de sessão. Gere com: openssl rand -hex 32
AUTH_SECRET=
# Admin inicial (criado no primeiro boot se não houver nenhum)
ADMIN_EMAIL=organizador@evento.com
ADMIN_PASSWORD=conecta123

# ===== Efí (Pix) — https://dev.efipay.com.br =====
# Deixe client_id/secret/cert em branco para rodar em modo MOCK (Pix fictício).
EFI_ENV=sandbox
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
EFI_CERT_PATH=./certs/efi-homolog.p12
EFI_PIX_KEY=
# Segredo usado como HMAC na URL do webhook (?hmac=) e p/ validar as notificações
EFI_WEBHOOK_TOKEN=

# ===== MikroTik (RouterOS API) =====
# Deixe host/senha em branco para rodar em modo MOCK (não conecta, só loga).
MIKROTIK_HOST=10.10.0.1
MIKROTIK_PORT=8728
MIKROTIK_USER=api
MIKROTIK_PASSWORD=
MIKROTIK_TLS=false
# Perfil/servidor Hotspot
MIKROTIK_HOTSPOT_PROFILE=default
MIKROTIK_HOTSPOT_SERVER=all
