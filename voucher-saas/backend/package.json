{
  "name": "conectavoucher-backend",
  "version": "0.1.0",
  "private": true,
  "description": "SaaS de venda de vouchers de internet em eventos — backend (Node + TypeScript)",
  "type": "commonjs",
  "scripts": {
    "dev": "prisma db push && ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "node-routeros": "^1.6.8",
    "sdk-node-apis-efi": "^1.2.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "prisma": "^6.19.3",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
