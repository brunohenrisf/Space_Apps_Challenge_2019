# Copie para .env e ajuste. Nenhuma variável é obrigatória para rodar local,
# mas ADMIN_PASSWORD, SESSION_SECRET e PUBLIC_URL são essenciais em produção.

# --- Identidade do casamento (aparece na página e nos cartões) --------------
COUPLE_NAMES="Ana & Bruno"
EVENT_DATE="12 de outubro de 2026"
WELCOME_MESSAGE="Você guardou um momento nosso na sua câmera. Manda pra gente?"

# --- Servidor ---------------------------------------------------------------
PORT=3000

# Endereço público do site. É o que vai dentro do QR Code das mesas.
PUBLIC_URL="https://fotos-ana-e-bruno.com.br"

# Ative quando rodar atrás de proxy (Railway, Render, Fly, Nginx, Cloudflare):
# sem isso o limite de envios enxerga todos os convidados como um só cliente.
TRUST_PROXY=false

# --- Painel dos noivos ------------------------------------------------------
# Sem ADMIN_PASSWORD, uma senha aleatória é impressa no console a cada boot.
ADMIN_PASSWORD="troque-esta-senha"

# Chave para assinar o cookie de sessão. Gere uma com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Horas até o painel pedir a senha de novo.
SESSION_HOURS=12

# --- Limites ----------------------------------------------------------------
MAX_FILE_SIZE_MB=30
UPLOAD_RATE_LIMIT=40
LOGIN_RATE_LIMIT=10
