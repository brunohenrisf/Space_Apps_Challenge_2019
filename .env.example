# Copie para .env e ajuste — o instalar.sh faz isso sozinho.
# Este arquivo é o ÚNICO que muda de uma casa para outra.

# Fuso da casa. Automações por horário e por sol dependem disto.
TZ=America/Sao_Paulo

# Caminho do dongle Zigbee. SEMPRE o /dev/serial/by-id/… (sobrevive a
# reinício; /dev/ttyUSB0 troca de número quando outro USB entra).
#   ls /dev/serial/by-id/
NEXO_SERIAL=/dev/serial/by-id/usb-ITEAD_SONOFF_Zigbee_3.0_USB_Dongle_Plus_V2_xxxxxxxx-if00

# Driver do coordenador:
#   ember  → SONOFF ZBDongle-E (EFR32MG21)
#   zstack → SONOFF ZBDongle-P / qualquer CC2652
NEXO_SERIAL_ADAPTADOR=ember

# Canal Zigbee, escolhido CONTRA o Wi-Fi da casa:
#   Wi-Fi no canal 1  → use 15 ou 20
#   Wi-Fi no canal 6  → use 15 ou 25
#   Wi-Fi no canal 11 → use 25
NEXO_CANAL=15

# Porta HTTP publicada pelo Caddy. No Pi da casa, deixe 80.
# Em bancada onde o host já usa a 80 (ZimaOS/CasaOS servem o painel
# deles nela), troque — 8090 é um bom hábito — e acesse http://<ip>:8090.
NEXO_HTTP=80
